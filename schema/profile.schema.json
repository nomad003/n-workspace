{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "n-workspace/profile",
  "title": "Profile",
  "type": "object",
  "description": "Free-form key/value map (name, birthday, city, contacts, documents...). Document items with an expires date feed the 总览 countdowns.",
  "properties": {
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "expires": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
