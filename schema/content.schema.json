{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "n-workspace/content",
  "title": "Content",
  "description": "n-knowledge-base data/content.yaml (feat/data-layer, see data/README.md). Top level has privacy, updated, sources. Unknown values are written 待补充. Secret-like fields are dropped by the loader.",
  "type": "object",
  "properties": {
    "privacy": {
      "enum": [
        "public",
        "private"
      ]
    },
    "updated": {
      "description": "YYYY-MM-DD, YYYY-MM, or annotated string; 待补充/待确认/不适用 = unknown"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "owner_agent": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "snapshots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "description": "YYYY-MM-DD, YYYY-MM, or annotated string; 待补充/待确认/不适用 = unknown"
                },
                "posts": {},
                "followers": {},
                "following": {}
              }
            }
          },
          "rules": {},
          "next": {},
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
