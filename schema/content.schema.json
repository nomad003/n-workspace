{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "n-workspace/content",
  "title": "Content item",
  "description": "KB file n-knowledge-base/data/content.yaml. Either a top-level list or {items|content: [...]}. Unknown fields are kept; secret-like fields (password/secret/token/recovery_code/pin/cvv) are dropped by the loader.",
  "oneOf": [
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    }
  ],
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "platform"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "platform": {
          "description": "x|bilibili|..."
        },
        "account": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "enum": [
            "idea",
            "draft",
            "scheduled",
            "published"
          ]
        },
        "publish_at": {
          "type": "string",
          "format": "date"
        },
        "url": {
          "type": "string"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "followers": {
          "type": "number"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "privacy": {
          "enum": [
            "public",
            "private"
          ],
          "default": "private"
        }
      }
    }
  }
}
