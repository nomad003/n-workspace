{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "n-workspace/accounts",
  "title": "Accounts",
  "description": "n-knowledge-base data/accounts.yaml (feat/data-layer, see data/README.md). Top level has privacy, updated, sources. Unknown values are written 待补充. Secret-like fields are dropped by the loader.",
  "type": "object",
  "properties": {
    "privacy": {
      "enum": [
        "public",
        "private"
      ]
    },
    "updated": {
      "description": "YYYY-MM-DD, YYYY-MM, or annotated string; 待补充/待确认/不适用 = unknown"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "login_method": {
            "type": "string"
          },
          "phone_binding": {
            "description": "tail digits only"
          },
          "two_fa": {
            "description": "status text; 待确认 = unknown"
          },
          "password_location": {
            "type": "string"
          },
          "status": {
            "description": "active | to-close | closed"
          },
          "risk": {
            "description": "P0–P4 importance"
          },
          "last_checked": {
            "description": "YYYY-MM-DD, YYYY-MM, or annotated string; 待补充/待确认/不适用 = unknown"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "conventions": {
      "type": "object"
    }
  }
}
