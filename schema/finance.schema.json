{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "n-workspace/finance",
  "title": "Finance",
  "description": "n-knowledge-base data/finance.yaml (feat/data-layer, see data/README.md). Top level has privacy, updated, sources. Unknown values are written 待补充. Secret-like fields are dropped by the loader.",
  "type": "object",
  "properties": {
    "privacy": {
      "enum": [
        "public",
        "private"
      ]
    },
    "updated": {
      "description": "YYYY-MM-DD, YYYY-MM, or annotated string; 待补充/待确认/不适用 = unknown"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "institution": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "identifier": {
            "description": "never the full number"
          },
          "status": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "income": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "amount": {}
        }
      }
    },
    "expenses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "amount": {}
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "amount": {},
          "balance": {},
          "value": {}
        }
      }
    },
    "liabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "balance": {},
          "rate_term": {
            "type": "string"
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "amount": {}
        }
      }
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "date": {
          "description": "YYYY-MM-DD, YYYY-MM, or annotated string; 待补充/待确认/不适用 = unknown"
        },
        "currency": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        }
      }
    }
  }
}
