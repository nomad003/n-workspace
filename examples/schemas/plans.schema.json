{
 "type": "object",
 "required": [
  "schema_version",
  "privacy",
  "updated",
  "plans"
 ],
 "properties": {
  "schema_version": {
   "enum": [
    9
   ]
  },
  "privacy": {
   "enum": [
    "private",
    "public"
   ]
  },
  "updated": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "sources": {
   "type": "array"
  },
  "plans": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "level",
     "period",
     "title",
     "status"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^p-[a-z0-9-]+$"
     },
     "level": {
      "enum": [
       "decade",
       "year",
       "half",
       "quarter",
       "month",
       "week"
      ]
     },
     "period": {
      "type": "string",
      "pattern": "^(\\d{4}(-\\d{4})?|\\d{4}-H[12]|\\d{4}-Q[1-4]|\\d{4}-\\d{2}|\\d{4}-W\\d{2})$"
     },
     "parent": {
      "type": [
       "string",
       "null"
      ]
     },
     "title": {
      "type": "string"
     },
     "area": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "enum": [
       "active",
       "done",
       "dropped",
       "planned"
      ]
     },
     "measure": {
      "type": [
       "string",
       "null"
      ]
     },
     "source": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  },
  "reviews": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "kind",
     "rrule",
     "duration_min",
     "checklist"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^r-[a-z0-9-]+$"
     },
     "kind": {
      "enum": [
       "quarterly",
       "annual",
       "monthly",
       "weekly"
      ]
     },
     "rrule": {
      "type": "string"
     },
     "duration_min": {
      "type": "integer"
     },
     "checklist": {
      "type": "array"
     },
     "template": {
      "type": [
       "string",
       "null"
      ]
     },
     "instances": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "period",
        "due",
        "status"
       ],
       "properties": {
        "period": {
         "type": "string"
        },
        "due": {
         "type": [
          "string",
          "null"
         ],
         "pattern": "^(\\d{4}-\\d{2}-\\d{2}|\\d{4}-\\d{2}|\\d{4}-Q[1-4]|\\d{4}-H[12]|\\d{4})$"
        },
        "status": {
         "enum": [
          "open",
          "done",
          "skipped"
         ]
        },
        "done_at": {
         "type": [
          "string",
          "null"
         ]
        },
        "note": {
         "type": [
          "string",
          "null"
         ]
        }
       }
      }
     }
    }
   }
  }
 }
}
