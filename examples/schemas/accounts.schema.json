{
 "type": "object",
 "required": [
  "schema_version",
  "privacy",
  "updated",
  "accounts"
 ],
 "properties": {
  "schema_version": {
   "enum": [
    9
   ]
  },
  "privacy": {
   "enum": [
    "private",
    "public"
   ]
  },
  "updated": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "sources": {
   "type": "array"
  },
  "accounts": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "service",
     "group",
     "subcategory",
     "identity_ids",
     "login_via",
     "priority",
     "two_fa",
     "status"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9\\u4e00-\\u9fff][a-z0-9\\u4e00-\\u9fff+-]*$"
     },
     "service": {
      "type": "string"
     },
     "group": {
      "enum": [
       "identity",
       "finance",
       "dev-ai",
       "social",
       "cloud",
       "life",
       "other"
      ]
     },
     "subcategory": {
      "type": "string"
     },
     "parent_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "identity_ids": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^id-(email|phone)-[a-z0-9]+$"
      }
     },
     "identity_note": {
      "type": [
       "string",
       "null"
      ]
     },
     "login_via": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "method"
       ],
       "properties": {
        "method": {
         "enum": [
          "password",
          "email-code",
          "sms",
          "oauth",
          "app-scan",
          "passkey",
          "unknown"
         ]
        },
        "via": {
         "type": [
          "string",
          "null"
         ]
        },
        "confirmed": {
         "type": "boolean"
        }
       }
      }
     },
     "recovery": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "priority": {
      "enum": [
       "P0",
       "P1",
       "P2",
       "P3",
       "P4"
      ]
     },
     "two_fa": {
      "enum": [
       "on",
       "off",
       "unknown",
       "na"
      ]
     },
     "two_fa_detail": {
      "type": [
       "string",
       "null"
      ]
     },
     "password_location": {
      "type": [
       "string",
       "null"
      ]
     },
     "url": {
      "type": [
       "string",
       "null"
      ]
     },
     "purpose": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "enum": [
       "active",
       "to-close",
       "closed"
      ]
     },
     "last_checked": {
      "type": [
       "string",
       "null"
      ]
     },
     "notes": {
      "type": [
       "string",
       "null"
      ]
     },
     "legacy": {
      "type": "object"
     }
    }
   }
  }
 }
}
