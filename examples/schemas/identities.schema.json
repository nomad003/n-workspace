{
 "type": "object",
 "required": [
  "schema_version",
  "privacy",
  "updated",
  "identities"
 ],
 "properties": {
  "schema_version": {
   "enum": [
    9
   ]
  },
  "privacy": {
   "enum": [
    "private",
    "public"
   ]
  },
  "updated": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "sources": {
   "type": "array"
  },
  "identities": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "type",
     "provider",
     "address_masked",
     "role",
     "two_fa",
     "status"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^id-(email|phone)-[a-z0-9]+$"
     },
     "type": {
      "enum": [
       "email",
       "phone"
      ]
     },
     "provider": {
      "type": "string"
     },
     "address_masked": {
      "type": "string",
      "pattern": "(\\*\\*\\*@|•••\\d{4}|尾号\\d{4})"
     },
     "role": {
      "type": "string"
     },
     "anchor_account": {
      "type": [
       "string",
       "null"
      ]
     },
     "recovery": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "two_fa": {
      "enum": [
       "on",
       "off",
       "unknown",
       "na"
      ]
     },
     "two_fa_detail": {
      "type": [
       "string",
       "null"
      ]
     },
     "password_location": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "enum": [
       "active",
       "closed"
      ]
     },
     "last_checked": {
      "type": [
       "string",
       "null"
      ]
     },
     "notes": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  }
 }
}
