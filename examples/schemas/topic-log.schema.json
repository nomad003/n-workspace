{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "one line of data/topic-logs/<topic-id>.jsonl (v9)",
 "type": "object",
 "required": [
  "date",
  "kind",
  "title"
 ],
 "additionalProperties": false,
 "properties": {
  "date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "kind": {
   "enum": [
    "event",
    "decision",
    "note",
    "review",
    "resource",
    "milestone",
    "issue",
    "metric",
    "status"
   ]
  },
  "title": {
   "type": "string"
  },
  "body": {
   "type": "string"
  },
  "tags": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "values": {
   "type": "object"
  },
  "ref": {
   "type": "string",
   "pattern": "^((kb|life)://|https?://|data/)"
  },
  "goal": {
   "type": "string"
  },
  "stage": {
   "type": [
    "string",
    "null"
   ]
  },
  "lifecycle": {
   "enum": [
    "active",
    "paused",
    "done",
    "archived"
   ]
  },
  "health": {
   "enum": [
    "on-track",
    "at-risk",
    "off-track",
    null
   ]
  },
  "resolves": {
   "type": "string",
   "description": "date+title of an earlier issue this entry closes, e.g. 2026-10-11#训练日未选定…"
  },
  "by": {
   "type": "string",
   "pattern": "^(user|agent:[a-z0-9-]+)$"
  },
  "source": {
   "type": "string",
   "pattern": "^((kb|life)://|data/|https?://|用户 \\d{4}-\\d{2}-\\d{2})"
  }
 },
 "x-kind-rules": {
  "status": "needs at least one of stage / lifecycle / health",
  "metric": "needs values",
  "resource": "needs ref",
  "milestone": "may set goal",
  "issue": "open until a later entry has resolves = <date>#<title>"
 }
}
